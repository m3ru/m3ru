/links/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=31536000, immutable

/links/main.css
  Cache-Control: public, max-age=86400

/links/theme.js
  Cache-Control: public, max-age=86400

# Pages must pick up new content and versioned CSS/JS URLs after a deploy.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Includes Cloudflare's extensionless URLs as well as .html URLs.
/site/*
  Cache-Control: public, max-age=0, must-revalidate
